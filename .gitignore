# OS and editor files
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
logs/

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/*.local
frontend/.eslintcache

# Backend runtime data and local binaries
data/
backend/data/*
!backend/data/.gitkeep
backend/opensync
backend/server
backend/*.db
backend/*.db-shm
backend/*.db-wal
backend/*.key

# Embedded frontend build output generated by `npm run build`
backend/cmd/server/web/*
!backend/cmd/server/web/.gitkeep

# Test and coverage output
coverage/
*.out

# AI 工具本地配置（客户端生成，与产品无关）
AGENTS.md
CLAUDE.md
# .claude/worktrees 下是整棵仓库的副本（还带自己的 .git），
# 不收进忽略名单的话，一次 git add -A 就会把重复仓库整个提交进来
.claude/
